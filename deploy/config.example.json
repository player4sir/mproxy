{
  "log_level": "info",
  "metrics_listen": "127.0.0.1:9090",
  "limits": {
    "max_conns": 20000,
    "max_conns_per_ip": 512,
    "idle_timeout": "5m",
    "handshake_timeout": "10s",
    "ban_after_failures": 8,
    "ban_duration": "10m",
    "shutdown_grace": "30s"
  },
  "outbound": {
    "dial_timeout": "8s",
    "block_private": true,
    "bind": ""
  },
  "listeners": [
    {
      "type": "vless",
      "listen": "0.0.0.0:443",
      "udp": true,
      "passwords": ["a5e18239-6523-446f-b258-2e06180632a7"],
      "reality": {
        "dest": "www.microsoft.com:443",
        "server_names": ["www.microsoft.com", "microsoft.com"],
        "private_key": "",
        "public_key": "",
        "short_ids": ["0123456789abcdef"]
      }
    },
    {
      "type": "vless",
      "listen": "0.0.0.0:8080",
      "udp": true,
      "passwords": ["a5e18239-6523-446f-b258-2e06180632a7"],
      "transport": {
        "type": "ws",
        "ws": {
          "path": "/vless-ws"
        }
      }
    },
    {
